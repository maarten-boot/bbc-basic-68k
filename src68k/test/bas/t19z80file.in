LOAD "ERRORTST"
SAVE "COPY.BBC"
L%=TOP-PAGE:A%=OPENIN "ERRORTST.BBC":B%=OPENIN "COPY.BBC":D%=0:FOR I%=1 TO L%:D%=D%-(BGET#A%<>BGET#B%):NEXT:CLOSE#A%:CLOSE#B%:PRINT "ERRORTST ";L%;" bytes, ";D%;" differ"
LOAD "EXITTEST"
SAVE "COPY.BBC"
L%=TOP-PAGE:A%=OPENIN "EXITTEST.BBC":B%=OPENIN "COPY.BBC":D%=0:FOR I%=1 TO L%:D%=D%-(BGET#A%<>BGET#B%):NEXT:CLOSE#A%:CLOSE#B%:PRINT "EXITTEST ";L%;" bytes, ";D%;" differ"
LOAD "FILETEST"
SAVE "COPY.BBC"
L%=TOP-PAGE:A%=OPENIN "FILETEST.BBC":B%=OPENIN "COPY.BBC":D%=0:FOR I%=1 TO L%:D%=D%-(BGET#A%<>BGET#B%):NEXT:CLOSE#A%:CLOSE#B%:PRINT "FILETEST ";L%;" bytes, ";D%;" differ"
LOAD "FORTEST"
SAVE "COPY.BBC"
L%=TOP-PAGE:A%=OPENIN "FORTEST.BBC":B%=OPENIN "COPY.BBC":D%=0:FOR I%=1 TO L%:D%=D%-(BGET#A%<>BGET#B%):NEXT:CLOSE#A%:CLOSE#B%:PRINT "FORTEST ";L%;" bytes, ";D%;" differ"
LOAD "INT32TST"
SAVE "COPY.BBC"
L%=TOP-PAGE:A%=OPENIN "INT32TST.BBC":B%=OPENIN "COPY.BBC":D%=0:FOR I%=1 TO L%:D%=D%-(BGET#A%<>BGET#B%):NEXT:CLOSE#A%:CLOSE#B%:PRINT "INT32TST ";L%;" bytes, ";D%;" differ"
